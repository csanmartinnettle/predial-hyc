rules_version = '2';

// Reglas de seguridad de Administración Predial - H&C
// - Solo entra quien conoce el código de acceso (guardado en privado/acceso, invisible para la app).
// - Cualquier usuario registrado ve terrenos, preguntas y reportes, y puede crear reportes firmados con su propio usuario.
// - Solo administradores editan preguntas, nombran administradores o borran/editan reportes y terrenos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function member() { return signedIn() && exists(userPath()); }
    function admin() { return member() && get(userPath()).data.rol == 'admin'; }
    function accessCode() { return get(/databases/$(database)/documents/privado/acceso).data.codigo; }

    // Código de acceso: solo se edita desde la consola de Firebase.
    match /privado/{docId} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow read: if member() && (request.auth.uid == uid || admin());
      // Alta: con el código correcto y siempre como usuario normal.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.codigo == accessCode()
        && request.resource.data.rol == 'usuario'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 2;
      // Cada uno puede cambiar su nombre; solo un administrador cambia el rol.
      allow update: if (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol'])
          && request.resource.data.rol in ['usuario', 'admin']);
      allow delete: if admin();
    }

    match /terrenos/{id} {
      allow read: if member();
      allow create: if member();
      allow update, delete: if admin();
    }

    match /preguntas/{id} {
      allow read: if member();
      allow write: if admin();
    }

    match /reportes/{rid} {
      allow read: if member();
      allow create: if member() && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if admin();

      match /fotos/{fid} {
        allow read: if member();
        allow create: if member()
          && getAfter(/databases/$(database)/documents/reportes/$(rid)).data.autorUid == request.auth.uid;
        allow update, delete: if admin();
      }
    }
  }
}
